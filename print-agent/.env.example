# URL of the cloud backend (see backend/.env PUBLIC_BASE_URL)
BACKEND_URL=http://localhost:4000

# This PC's unique identity. Must have a matching entry in the backend's
# AGENT_CREDENTIALS env var, e.g. AGENT_CREDENTIALS=PC-001:CHANGE_THIS_SECRET
PRINT_AGENT_ID=PC-001
PRINT_AGENT_SECRET=CHANGE_THIS_SECRET

# Exact Windows printer name to print to. Leave blank and run
# `npm run setup-printer` to pick one interactively - it will fill this in.
PRINTER_NAME=

# How often (ms) the agent checks the backend for new jobs
POLL_INTERVAL=5000

# Local dashboard (http://localhost:3001)
DASHBOARD_PORT=3001

# Timeout (ms) for backend HTTP requests
REQUEST_TIMEOUT=8000
