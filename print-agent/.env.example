# URL of the cloud backend (see backend/.env PUBLIC_BASE_URL)
BACKEND_URL=http://localhost:4000

# This PC's unique identity - pick anything, e.g. PC-001, AGENT-AHMEDABAD-01.
PRINT_AGENT_ID=PC-001

# Leave blank on first run. The agent will call POST /api/agents/register,
# receive a secret token, and write it back into this file automatically.
# Never set this by hand or share it - delete it to force re-registration.
PRINT_AGENT_TOKEN=

# How often (ms) the agent checks the backend for new jobs
POLL_INTERVAL=5000

# Local dashboard (http://localhost:3001)
DASHBOARD_PORT=3001

# Timeout (ms) for backend HTTP requests
REQUEST_TIMEOUT=8000
