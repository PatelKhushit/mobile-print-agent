# URL of the cloud backend (see backend/.env PUBLIC_BASE_URL)
BACKEND_URL=http://localhost:4000

# This PC's unique identity - pick anything, e.g. PC-001, AGENT-AHMEDABAD-01.
PRINT_AGENT_ID=PC-001

# Optional. Set this to pair the agent with a shop the platform owner
# created (copy the Shop ID from the shop owner dashboard), e.g. SHOP-001.
# Leave blank for standalone/personal use - default, no shop involved.
SHOP_ID=

# Optional. A one-time pairing code from the shop owner's dashboard
# ("Connect New Print Agent"), used instead of SHOP_ID. If both this and
# SHOP_ID are blank and the agent is run from a real console, it will
# prompt for a pairing code interactively on first run (Enter to skip and
# register standalone). Only used once, at registration - safe to clear
# after the agent has a PRINT_AGENT_TOKEN.
PAIRING_CODE=

# Leave blank on first run. The agent will call POST /api/agents/register,
# receive a secret token, and write it back into this file automatically.
# Never set this by hand or share it - delete it to force re-registration.
PRINT_AGENT_TOKEN=

# How often (ms) the agent checks the backend for new jobs
POLL_INTERVAL=5000

# Local dashboard (http://localhost:3001)
DASHBOARD_PORT=3001

# Timeout (ms) for backend HTTP requests
REQUEST_TIMEOUT=8000
