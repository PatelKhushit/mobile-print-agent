# Server
PORT=4000
NODE_ENV=development

# Public base URL this server is reachable at (used to build fileUrl links).
# In production this must be your HTTPS domain, e.g. https://print.example.com
PUBLIC_BASE_URL=http://localhost:4000

# CORS - comma separated list of allowed origins, or * for the trial version
CORS_ORIGIN=*

# Print Agent credentials - comma separated "agentId:secret" pairs.
# Each Local Print Agent authenticates with one of these pairs.
# MUST match PRINT_AGENT_ID / PRINT_AGENT_SECRET in print-agent/.env
# Add one entry per PC, e.g. PC-001:supersecret1,PC-002:supersecret2
AGENT_CREDENTIALS=PC-001:CHANGE_THIS_SECRET

# File upload limits
MAX_FILE_SIZE_MB=10

# A job that stays "claimed" or "printing" longer than this is considered
# abandoned and is released back to the queue so another agent can retry it.
JOB_CLAIM_TIMEOUT_MS=120000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
