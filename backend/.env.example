# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string (e.g. a free MongoDB Atlas cluster).
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/print-system
MONGODB_URI=

# Secret used to sign mobile-user JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_VALUE

# Public base URL this server is reachable at (used to build fileUrl links).
# In production this must be your HTTPS domain, e.g. https://print.example.com
PUBLIC_BASE_URL=http://localhost:4000

# Where the customer-facing web app lives - used only to build the URL
# encoded into a shop's QR code. In production this must be the deployed
# frontend URL, e.g. https://frontend-drab-seven-4mo4avvait.vercel.app
FRONTEND_BASE_URL=http://localhost:5173

# CORS - comma separated list of allowed origins, or * for the trial version
CORS_ORIGIN=*

# File upload limits
MAX_FILE_SIZE_MB=10

# A job that stays "claimed" or "printing" longer than this is considered
# abandoned and is released back to the queue so another agent can retry it.
JOB_CLAIM_TIMEOUT_MS=120000

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
